# DISCORD BOT CREDENTIALS
# Lấy từ https://discord.com/developers/applications
DISCORD_TOKEN=your_bot_token_here
CLIENT_ID=your_client_id_here
GUILD_ID=your_discord_server_id_here

# DISCORD ROLE & CHANNEL CONFIGURATION
# ID của Role sẽ được gán khi nhân viên vào ca (ví dụ: @On-Shift)
ON_SHIFT_ROLE_ID=your_on_shift_role_id_here
# ID của Kênh bot gửi cảnh báo nhắc nhở 18:00 và 22:00 (ví dụ: #canh-bao-gio hoặc #chung)
ALERT_CHANNEL_ID=your_alert_channel_id_here

# THIẾT LẬP NGHIỆP VỤ (BUSINESS RULES)
# Chỉ tiêu giờ tối thiểu 1 ngày (mặc định 8.0 tiếng)
DAILY_TARGET_HOURS=8.0
# Mốc chốt ngày (Cut-off Time): 6 nghĩa là 06:00 sáng
CUTOFF_HOUR=6
# Múi giờ (mặc định Việt Nam: Asia/Ho_Chi_Minh)
TIMEZONE=Asia/Ho_Chi_Minh
